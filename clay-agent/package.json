{
  "name": "clay-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clay-owned Node daemon hosting Prism 0.3.0 over stdio JSON-RPC.",
  "bin": {
    "clay-agent": "./dist/main.js"
  },
  "exports": {
    ".": "./dist/host.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/__tests__/*.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@arnilo/prism": "0.3.0",
    "@arnilo/prism-credentials-node": "0.3.0",
    "@arnilo/prism-model-router": "0.3.0",
    "@arnilo/prism-provider-alibaba": "0.3.0",
    "@arnilo/prism-provider-anthropic": "0.3.0",
    "@arnilo/prism-provider-azure": "0.3.0",
    "@arnilo/prism-provider-bedrock": "0.3.0",
    "@arnilo/prism-provider-clinepass": "0.3.0",
    "@arnilo/prism-provider-deepseek": "0.3.0",
    "@arnilo/prism-provider-google": "0.3.0",
    "@arnilo/prism-provider-kimi": "0.3.0",
    "@arnilo/prism-provider-neuralwatt": "0.3.0",
    "@arnilo/prism-provider-ollama": "0.3.0",
    "@arnilo/prism-provider-openai": "0.3.0",
    "@arnilo/prism-provider-opencode-go": "0.3.0",
    "@arnilo/prism-provider-openrouter": "0.3.0",
    "@arnilo/prism-provider-vertex": "0.3.0",
    "@arnilo/prism-provider-xai": "0.3.0",
    "@arnilo/prism-provider-zai": "0.3.0",
    "@arnilo/prism-providers": "0.3.0",
    "@arnilo/prism-session-store-sqlite": "0.3.0",
    "@arnilo/prism-tool-validator-json-schema": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
