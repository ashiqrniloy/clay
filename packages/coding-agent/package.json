{
  "name": "@clay/coding-agent",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./load": "./dist/load.js"
  },
  "clay": {
    "apiPrefix": "coding-agent",
    "entry": "./dist/index.js",
    "loadEntry": "./dist/load.js",
    "permissions": [
      "command-registration"
    ],
    "docs": "./docs/index.md",
    "apiDependencies": [
      "ui.serverRegisterPaneContentContribution",
      "agent.profileRegister",
      "agent.skillRegister"
    ],
    "performance": {
      "estimatedManifestBytes": 4528,
      "hotPathPolicy": "no hot-path JS on keypress/paint"
    },
    "contributions": {
      "commands": [
        {
          "id": "coding-agent.profile",
          "displayName": "Coding Agent",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.compact",
          "displayName": "/compact",
          "title": "Compact Session",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.new",
          "displayName": "/new",
          "title": "New Session",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.n",
          "displayName": "/n",
          "title": "New Session (Alias)",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.branch",
          "displayName": "/branch",
          "title": "Checkout Branch Point",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.tree",
          "displayName": "/tree",
          "title": "Session Branch Tree",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.discard",
          "displayName": "/discard",
          "title": "Discard Branch",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.fork",
          "displayName": "/fork",
          "title": "Fork Session",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.clone",
          "displayName": "/clone",
          "title": "Clone Session",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.openSession",
          "displayName": "/open-session",
          "title": "Open Session by ID",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.openSessionAsFork",
          "displayName": "/open-session-as-fork",
          "title": "Open Session as Fork",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.resume",
          "displayName": "/resume",
          "title": "Resume Session",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.close",
          "displayName": "Close Coding Agent",
          "routingPolicy": "server-first"
        },
        {
          "id": "coding-agent.clientCycleEffort",
          "displayName": "Cycle Reasoning Effort",
          "title": "Cycle the reasoning-effort level for the coding agent",
          "routingPolicy": "server-first"
        }
      ],
      "keyRouting": [
        {
          "commandId": "coding-agent.clientCycleEffort",
          "key": "Shift+Tab"
        }
      ],
      "ui": {
        "paneContents": [
          {
            "id": "coding-agent.surface",
            "activation": "pane",
            "actionTargets": [
              "coding-agent.profile",
              "coding-agent.close",
              "chat.submit",
              "chat.cancel",
              "chat.steer",
              "agent.clientOpenModelPicker",
              "agent.clientOpenSessionPicker",
              "documents.clientOpenFileDialog"
            ],
            "component": {
              "kind": "panel",
              "id": "coding-agent.root",
              "title": "Coding Agent",
              "children": [
                {
                  "kind": "label",
                  "id": "coding-agent.transcriptTitle",
                  "text": "Coding Agent",
                  "style": {
                    "typography": "typography.title"
                  }
                },
                {
                  "kind": "label",
                  "id": "coding-agent.emptyHint",
                  "text": "No conversation yet.",
                  "style": {
                    "typography": "typography.caption"
                  }
                },
                {
                  "kind": "textInput",
                  "id": "coding-agent.composer",
                  "title": "Message",
                  "multiline": true
                }
              ]
            }
          }
        ]
      }
    },
    "extensionPoints": [
      {
        "id": "coding-agent.chromeActions",
        "version": 1,
        "operations": [
          "append",
          "replace"
        ],
        "contributionKinds": [
          "command"
        ],
        "scopes": [
          "coding-agent.profile"
        ],
        "summary": "Add or replace Coding Agent chrome commands."
      }
    ],
    "modes": []
  }
}
