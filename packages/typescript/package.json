{
  "name": "@clay/typescript",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./load": "./dist/load.js"
  },
  "clay": {
    "apiPrefix": "typescript",
    "preset": "code-mode",
    "entry": "./dist/index.js",
    "loadEntry": "./dist/load.js",
    "modes": [
      "typescript"
    ],
    "docs": "./docs/index.md",
    "performance": {
      "estimatedManifestBytes": 1900,
      "hotPathPolicy": "grammar metadata validated at load; no hot-path JS"
    },
    "contributions": {
      "modePatterns": [
        {
          "mode": "typescript",
          "displayName": "TypeScript",
          "extensions": [
            "ts",
            "tsx",
            "mts",
            "cts"
          ],
          "defaultFontRole": "monospace",
          "editorRules": {
            "enter": {
              "kind": "preserveLeadingWhitespace"
            },
            "pairs": [
              {
                "open": "(",
                "close": ")"
              },
              {
                "open": "[",
                "close": "]"
              },
              {
                "open": "{",
                "close": "}"
              },
              {
                "open": "\"",
                "close": "\""
              },
              {
                "open": "'",
                "close": "'"
              },
              {
                "open": "`",
                "close": "`"
              }
            ],
            "comments": [
              {
                "linePrefix": "//",
                "continuePrefix": "// "
              }
            ],
            "tabSpaces": 2,
            "electricCharacters": [
              {
                "trigger": "}",
                "effect": "outdent-one-level"
              },
              {
                "trigger": ")",
                "effect": "outdent-one-level"
              },
              {
                "trigger": "]",
                "effect": "outdent-one-level"
              }
            ],
            "autocompleteTriggers": [
              {
                "trigger": "."
              }
            ],
            "movement": {
              "wordSeparators": "code"
            }
          }
        }
      ],
      "commands": [
        {
          "id": "typescript.toggleLineComment",
          "displayName": "Toggle TypeScript Line Comment",
          "routingPolicy": "server-first"
        }
      ],
      "completionProviders": [
        {
          "id": "typescript.keywords",
          "priority": 0,
          "triggerCharacters": [
            "."
          ],
          "wordBoundaryChars": [
            ".",
            ";",
            ","
          ],
          "budgets": {
            "timeoutMs": 300,
            "maxItems": 32
          },
          "items": [
            "as",
            "async",
            "await",
            "break",
            "case",
            "catch",
            "class",
            "const",
            "continue",
            "default",
            "do",
            "else",
            "enum",
            "export",
            "extends",
            "false",
            "finally",
            "for",
            "from",
            "function",
            "if",
            "implements",
            "import",
            "in",
            "instanceof",
            "interface",
            "let",
            "new",
            "return",
            "true",
            "type",
            "while"
          ]
        },
        {
          "id": "typescript.snippets",
          "priority": 0,
          "triggerCharacters": [
            "."
          ],
          "wordBoundaryChars": [
            ".",
            ";",
            ","
          ],
          "budgets": {
            "timeoutMs": 300,
            "maxItems": 32
          },
          "items": [
            {
              "label": "interface",
              "insertText": "interface ${1:Name} {\n  $0\n}",
              "textFormat": "snippet",
              "detail": "interface snippet"
            },
            {
              "label": "type",
              "insertText": "type ${1:Name} = ${2:Type};$0",
              "textFormat": "snippet",
              "detail": "type alias snippet"
            }
          ]
        }
      ],
      "ui": {
        "components": [
          {
            "kind": "statusItem",
            "id": "typescript.status.mode",
            "style": {
              "variant": "muted"
            }
          }
        ]
      }
    }
  }
}
